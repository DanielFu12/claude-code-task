[{"text": "宽不宽，还是过两关。", "words": [{"word": "宽", "startTime": 0, "endTime": 0.08}, {"word": "不", "startTime": 0.16, "endTime": 0.36}, {"word": "宽", "startTime": 0.4, "endTime": 0.52}, {"word": "，", "startTime": 0.52, "endTime": 0.52}, {"word": "还", "startTime": 0.72, "endTime": 0.84}, {"word": "是", "startTime": 0.84, "endTime": 0.96}, {"word": "过", "startTime": 0.96, "endTime": 1.12}, {"word": "两", "startTime": 1.2, "endTime": 1.36}, {"word": "关", "startTime": 1.44, "endTime": 1.48}, {"word": "。", "startTime": 1.48, "endTime": 1.48}]}, {"text": "第一关：优势是不是真的。\n", "words": [{"word": "第", "startTime": 1.7600417, "endTime": 1.9600416}, {"word": "一", "startTime": 1.9600416, "endTime": 2.0800416}, {"word": "关", "startTime": 2.1200416, "endTime": 2.2400417}, {"word": "：", "startTime": 2.2400417, "endTime": 2.2400417}, {"word": "优", "startTime": 2.5600417, "endTime": 2.8000417}, {"word": "势", "startTime": 2.8000417, "endTime": 2.8800416}, {"word": "是", "startTime": 3.0000417, "endTime": 3.0800416}, {"word": "不", "startTime": 3.0800416, "endTime": 3.2400417}, {"word": "是", "startTime": 3.2400417, "endTime": 3.2800417}, {"word": "真", "startTime": 3.2800417, "endTime": 3.4400415}, {"word": "的", "startTime": 3.4400415, "endTime": 3.6400416}, {"word": "。", "startTime": 3.6400416, "endTime": 3.6400416}]}, {"text": "铁路最大的对手是卡车。", "words": [{"word": "铁", "startTime": 4.0000834, "endTime": 4.2000833}, {"word": "路", "startTime": 4.280083, "endTime": 4.4000835}, {"word": "最", "startTime": 4.4800835, "endTime": 4.6000834}, {"word": "大", "startTime": 4.6000834, "endTime": 4.720083}, {"word": "的", "startTime": 4.720083, "endTime": 4.840083}, {"word": "对", "startTime": 4.840083, "endTime": 4.960083}, {"word": "手", "startTime": 4.960083, "endTime": 5.0800834}, {"word": "是", "startTime": 5.0800834, "endTime": 5.240083}, {"word": "卡", "startTime": 5.240083, "endTime": 5.4000835}, {"word": "车", "startTime": 5.4400835, "endTime": 5.6000834}, {"word": "。", "startTime": 5.6000834, "endTime": 5.60