42}, {"word": "穆", "startTime": 35.422417, "endTime": 35.462418}, {"word": "迪", "startTime": 35.622417, "endTime": 35.66242}, {"word": "评", "startTime": 35.782417, "endTime": 35.82242}, {"word": "级", "startTime": 35.942417, "endTime": 35.982418}, {"word": "。", "startTime": 35.982418, "endTime": 35.982418}]}, {"text": "巴菲特说，这门生意他是从两边看的：\n", "words": [{"word": "巴", "startTime": 36.14246, "endTime": 36.22246}, {"word": "菲", "startTime": 36.38246, "endTime": 36.46246}, {"word": "特", "startTime": 36.582462, "endTime": 36.78246}, {"word": "说", "startTime": 36.78246, "endTime": 36.98246}, {"word": "，", "startTime": 36.98246, "endTime": 36.98246}, {"word": "这", "startTime": 36.98246, "endTime": 37.18246}, {"word": "门", "startTime": 37.22246, "endTime": 37.34246}, {"word": "生", "startTime": 37.422462, "endTime": 37.582462}, {"word": "意", "startTime": 37.582462, "endTime": 37.70246}, {"word": "他", "startTime": 37.86246, "endTime": 37.94246}, {"word": "是", "startTime": 37.94246, "endTime": 38.06246}, {"word": "从", "startTime": 38.06246, "endTime": 38.18246}, {"word": "两", "startTime": 38.18246, "endTime": 38.30246}, {"word": "边", "startTime": 38.30246, "endTime": 38.46246}, {"word": "看", "startTime": 38.46246, "endTime": 38.62246}, {"word": "的", "startTime": 38.62246, "endTime": 38.82246}, {"word": "：", "startTime": 38.82246, "endTime": 38.82246}]}, {"text": "顾客不情愿，却离不开。", "words": [{"word": "顾", "startTime": 38.982502, "endTime": 39.182503}, {"word": "客", "startTime": 39.182503, "endTime": 39.382504}, {"word": "不", "startTime": 39.422504, "endTime": 39.542503}, {"word": "情", "startTime": 39.582504, "endTime": 39.662502}, {"word": "愿", "startTime": 39.822502, "endTime": 39.902504}, {"word": "，", "startTime": 39.902504, "endTime": 39.902504}, {"word": "却", "startTime": 40.022503, "endTime": 40.222504}, {"word": "离", "startTime": 40.222504, "endTime": 40.382504}, {"word": "不", "startTime": 40.382504, "endTime": 40.502502}, {"word": "开", "startTime": 40.502502, "endTime": 40.6225}, {"word": "。", "startTime": 40.6225, "endTime": 40.6225}]}, {"text": "这样的生意，管理层要紧吗？", "words": [{"word": "这", "startTime": 40.912544, "endTime": 41.032543}, {"word": "样", "startTime": 41.032543, "endTime": 41.152546}, {"word": "的", "startTime": 41.152546, "endTime": 41.232544}, {"word": "生", "startTime": 41.232544, "endTime": 41.352543}, {"word": "意", "startTime": 41.352543, "endTime": 41.472546}, {"word": "，", "startTime": 41.472546, "endTime": 41.472546}, {"word": "管", "startTime": 41.592545, "endTime": 41.632545}, {"word": "理", "startTime": 41.632545, "endTime": 41.672543}, {"word": "层", "startTime": 41.672543, "endTime": 41.712543}, {"word": "要", "startTime": 41.712543, "endTime": 41.752544}, {"word": "紧", "startTime": 41.752544, "endTime": 41.792545}, {"word": "吗", "startTime": 41.792545, "endTime": 42.632545}, {"word": "？", "startTime": 42.632545, "endTime": 42.632545}]}, {"text": "巴菲特说，他不认识穆迪的管理层；", "words": [{"word": "巴", "startTime": 42.752586, "endTime": 42.832584}, {"word": "菲", "startTime": 42.952583, "endTime": 43.032585}, {"word": "特", "startTime": 43.152584, "endTime": 43.352585}, {"word": "说", "startTime": 43.352585, "endTime": 43.512585}, {"word": "，", "startTime": 43.512585, "endTime": 43.512585}, {"word": "他", "startTime": 43.512585, "endTime": 43.712585}, {"word": "不", "startTime": 43.712585, "endTime": 43.832584}, {"word": "认", "startTime": 43.832584, "endTime": 43.912586}, {"word": "识", "startTime": 43.912586, "endTime": 44.032585}, {"word": "穆", "startTime": 44.112583, "endTime": 44.152584}, {"word": "迪", "startTime": 44.312584, "endTime": 44.352585}, {"word": "的", "startTime": 44.392586, "endTime": 44.552586}, {"word": "管", "startTime": 44.552586, "endTime": 44.672585}, {"word": "理", "startTime": 44.672585, "endTime": 44.792583}, {"word": "层", "startTime": 44.832584, "endTime": 44.872585}, {"word": "；", "startTime": 44.872585, "endTime": 44.872585}]}, {"text": "非凡的生意，不需要很好的管理。\n", "words": [{"word": "非", "startTime": 45.11263, "endTime": 45