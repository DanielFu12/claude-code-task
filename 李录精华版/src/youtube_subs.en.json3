  "events": [ {
    "tStartMs": 6580,
    "dDurationMs": 959,
    "segs": [ {
      "utf8": "- Thank you so much."
    } ]
  }, {
    "tStartMs": 7539,
    "dDurationMs": 1121,
    "segs": [ {
      "utf8": "Thank you so much. I know"
    } ]
  }, {
    "tStartMs": 8660,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "that you guys are incredibly\nexcited to be here,"
    } ]
  }, {
    "tStartMs": 10480,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and I know it's not\nbecause of me, but rather"
    } ]
  }, {
    "tStartMs": 13120,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "because of our guests today\nwho I will introduce shortly."
    } ]
  }, {
    "tStartMs": 19260,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "So before we start with the\ninterview, let me take a couple"
    } ]
  }, {
    "tStartMs": 21960,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "of minutes to tell you a little bit that"
    } ]
  }, {
    "tStartMs": 24740,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "as always at this time of the year,"
    } ]
  }, {
    "tStartMs": 28080,
    "dDurationMs": 3019,
    "segs": [ {
      "utf8": "the Helbrand year is up\nand running in full swing."
    } ]
  }, {
    "tStartMs": 32120,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "The students, some of whom\nare here, took already my"
    } ]
  }, {
    "tStartMs": 36120,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "modern value class."
    } ]
  }, {
    "tStartMs": 37480,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "They're taking their applied\nvalue investing class,"
    } ]
  }, {
    "tStartMs": 40740,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "their create superhighway,\nall the electives."
    } ]
  }, {
    "tStartMs": 43720,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "So we're having a blast. They're\nall absolutely wonderful."
    } ]
  }, {
    "tStartMs": 47420,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "In addition, we have a new initiative"
    } ]
  }, {
    "tStartMs": 50220,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "this year in the Helberg Center."
    } ]
  }, {
    "tStartMs": 51520,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "We launch our first global\nvalue investor program."
    } ]
  }, {
    "tStartMs": 55120,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "And the first cohort of that\nprogram that is joint effort"
    } ]
  }, {
    "tStartMs": 59600,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "with Columbia Business School\nExecutive Education is here."
    } ]
  }, {
    "tStartMs": 61920,
    "dDurationMs": 2879,
    "segs": [ {
      "utf8": "So these are all these\nwonderful friends from China"
    } ]
  }, {
    "tStartMs": 64799,
    "dDurationMs": 2161,
    "segs": [ {
      "utf8": "who are visiting us this year."
    } ]
  }, {
    "tStartMs": 66960,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "So thank you so much for being here."
    } ]
  }, {
    "tStartMs": 71140,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Michael and I,"
    } ]
  }, {
    "tStartMs": 72760,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "I get asked this question\na little bit too often."
    } ]
  }, {
    "tStartMs": 76320,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "We're already working on a new\nseason of the Value Investing"
    } ]
  }, {
    "tStartMs": 79300,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "with Layens podcast."
    } ]
  }, {
    "tStartMs": 81980,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "So episodes will be coming soon."
    } ]
  }, {
    "tStartMs": 86560,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "So that is something to look forward to."
    } ]
  }, {
    "tStartMs": 89160,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "We made our new stock selections\nfor the student portfolio,"
    } ]
  }, {
    "tStartMs": 93840,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "the Tom Russo student portfolio."
    } ]
  }, {
    "tStartMs": 97460,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "I don't know what we bought\nthis year, Equifax, Humana."
    } ]
  }, {
    "tStartMs": 102200,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "We bought, what else?"
    } ]
  }, {
    "tStartMs": 103560,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "We bought the great Japanese\nbicycle company, Shimano,"
    } ]
  }, {
    "tStartMs": 106300,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "a classic value play."
    } ]
  }, {
    "tStartMs": 107940,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "There, there was one, COPA,\nthe online corruption company,"
    } ]
  }, {
    "tStartMs": 111960,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "Perimeter Solutions, Fire Solutions."
    } ]
  }, {
    "tStartMs": 114500,
    "dDurationMs": 1139,
    "segs": [ {
      "utf8": "So a lot of fun things."
    } ]
  }, {
    "tStartMs": 115639,
    "dDurationMs": 1801,
    "segs": [ {
      "utf8": "And as I always do,"
    } ]
  }, {
    "tStartMs": 117440,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "you can actually download all\nthe reports the students did"
    } ]
  }, {
    "tStartMs": 122600,
    "dDurationMs": 1539,
    "segs": [ {
      "utf8": "over the years on the different companies."
    } ]
  }, {
    "tStartMs": 124139,
    "dDurationMs": 1161,
    "segs": [ {
      "utf8": "A wonderful resource,"
    } ]
  }, {
    "tStartMs": 125300,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "and I very much encourage\nyou to look at that."
    } ]
  }, {
    "tStartMs": 129220,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "And I'm always amazed, by\nthe way, I want to single out"
    } ]
  }, {
    "tStartMs": 133580,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "a wonderful member of our community."
    } ]
  }, {
    "tStartMs": 135280,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "I'm always amazed about\nTom Russo's generosity"
    } ]
  }, {
    "tStartMs": 138960,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "with the Helberg Center, not only"
    } ]
  }, {
    "tStartMs": 140620,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "because of the student portfolio,\nbecause everything he does"
    } ]
  }, {
    "tStartMs": 144980,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "for the program, and in particular\nthis year of making sure"
    } ]
  }, {
    "tStartMs": 147560,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "that our friendly Lou could be here"
    } ]
  }, {
    "tStartMs": 150760,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "for which we're always thankful."
    } ]
  }, {
    "tStartMs": 153720,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "We just had a wonderful week,"
    } ]
  }, {
    "tStartMs": 155460,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "as I told you just a moment\nago with this new program,"
    } ]
  }, {
    "tStartMs": 158320,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "the Global Value Investor Program."
    } ]
  }, {
    "tStartMs": 159700,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Andrew Gunlach"
    } ]
  }, {
    "tStartMs": 161140,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "and Kristen Gilbertson\nput on a show for them,"
    } ]
  }, {
    "tStartMs": 164500,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "which I also want to acknowledge publicly."
    } ]
  }, {
    "tStartMs": 168020,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "And finally, we're getting ready"
    } ]
  }, {
    "tStartMs": 170080,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "for a terrific SEMA conference."
    } ]
  }, {
    "tStartMs": 173960,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "And it's just amazing the"
    } ]
  }, {
    "tStartMs": 177960,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "names that are coming this year."
    } ]
  }, {
    "tStartMs": 179780,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "Hello, boss. So we're going to have"
    } ]
  }, {
    "tStartMs": 184240,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "Howard Marks, Bill Ackman\nwill be there, Josh Wolf"
    } ]
  }, {
    "tStartMs": 188500,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "of Lux Capital will be there,"
    } ]
  }, {
    "tStartMs": 191440,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "Samantha McLamore from Patient Capital."
    } ]
  }, {
    "tStartMs": 194060,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "So I very much hope to\nsee many of you there."
    } ]
  }, {
    "tStartMs": 198920,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "Okay? Now to the main event of the year."
    } ]
  }, {
    "tStartMs": 203160,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "So Lilu, of course, needs no introduction"
    } ]
  }, {
    "tStartMs": 207200,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "as he's truly one"
    } ]
  }, {
    "tStartMs": 208480,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "of the great modern\nvalue investing legends."
    } ]
  }, {
    "tStartMs": 211580,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "He's of course the founder"
    } ]
  }, {
    "tStartMs": 212720,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "and chairman of Himalaya Capital,\nwhich he founded in 1997."
    } ]
  }, {
    "tStartMs": 217340,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "He's built an enumerous record"
    } ]
  }, {
    "tStartMs": 218960,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "of performance in the last 30 years."
    } ]
  }, {
    "tStartMs": 221780,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Lilu, as many of you know, is one"
    } ]
  }, {
    "tStartMs": 223460,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "of our most distinguished alums."
    } ]
  }, {
    "tStartMs": 225180,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "He graduated with a law\ndegree, an MBA degree"
    } ]
  }, {
    "tStartMs": 227340,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "and a BA from Columbia College"
    } ]
  }, {
    "tStartMs": 229840,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "because why get just one\ndegree when you can get three?"
    } ]
  }, {
    "tStartMs": 234240,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Apparently this was how\nhe though about this."
    } ]
  }, {
    "tStartMs": 237600,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "His personal story is well\nknown. I won't repeat it here."
    } ]
  }, {
    "tStartMs": 241219,
    "dDurationMs": 3521,
    "segs": [ {
      "utf8": "Lilu is of course famous\nas an early investor in BYD"
    } ]
  }, {
    "tStartMs": 244740,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "and many of the great Chinese names"
    } ]
  }, {
    "tStartMs": 246100,
    "dDurationMs": 4079,
    "segs": [ {
      "utf8": "and will have the opportunity\nto discuss issues related"
    } ]
  }, {
    "tStartMs": 250179,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "to the Chinese stock market\ntoday with all of you."
    } ]
  }, {
    "tStartMs": 254220,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "So first of all, Lilu, welcome"
    } ]
  }, {
    "tStartMs": 255400,
    "dDurationMs": 1719,
    "segs": [ {
      "utf8": "and thank you so much for being here."
    } ]
  }, {
    "tStartMs": 257119,
    "dDurationMs": 1901,
    "segs": [ {
      "utf8": "- Thank you, Tano. It is"
    } ]
  }, {
    "tStartMs": 259020,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "- Fabulous."
    } ]
  }, {
    "tStartMs": 260020,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "Yeah. So I'm going to\ntalk for about 50 minutes"
    } ]
  }, {
    "tStartMs": 263720,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "and then I will open it up for questions"
    } ]
  }, {
    "tStartMs": 266980,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "and I'm going to ask you to\nkeep them short and to the point"
    } ]
  }, {
    "tStartMs": 269280,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "and I will be ruthless."
    } ]
  }, {
    "tStartMs": 270640,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "If you take more time than\nwhat I consider necessary"
    } ]
  }, {
    "tStartMs": 274160,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "to get your point across,\nI will cut you off"
    } ]
  }, {
    "tStartMs": 276860,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "and I'll give you a nasty look."
    } ]
  }, {
    "tStartMs": 279540,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Okay? So just keep them"
    } ]
  }, {
    "tStartMs": 282260,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "because I'm sure there will\nbe many, many questions."
    } ]
  }, {
    "tStartMs": 284300,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Okay? So Lilu, I want\nto start a little bit."
    } ]
  }, {
    "tStartMs": 289600,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "You are, as I said, one"
    } ]
  }, {
    "tStartMs": 291080,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "of the great names in\nmodern value investing."
    } ]
  }, {
    "tStartMs": 294520,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "You're deeply intertwined\nas well with the story"
    } ]
  }, {
    "tStartMs": 296440,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "of value investing at\nColumbia Business School."
    } ]
  }, {
    "tStartMs": 297820,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "We were talking about that over lunch."
    } ]
  }, {
    "tStartMs": 299920,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "You were there at the very\nbeginning when Bruce was"
    } ]
  }, {
    "tStartMs": 301640,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "launching this program."
    } ]
  }, {
    "tStartMs": 304420,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "We know of your friendship and\npartnership with both Charlie"
    } ]
  }, {
    "tStartMs": 307020,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "and Warren and how many\nthings you guys did together."
    } ]
  }, {
    "tStartMs": 310720,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "We will be celebrating\n30 years of the founding"
    } ]
  }, {
    "tStartMs": 312840,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "of Himalaya Capital next year, which is"
    } ]
  }, {
    "tStartMs": 316340,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "a remarkable achievement."
    } ]
  }, {
    "tStartMs": 318400,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "So I want to start here."
    } ]
  }, {
    "tStartMs": 320000,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "I want you to tell us a little bit what is"
    } ]
  }, {
    "tStartMs": 323840,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "that you learned about value investing"
    } ]
  }, {
    "tStartMs": 325340,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "and where do you think we are today?"
    } ]
  }, {
    "tStartMs": 326720,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "What is the thing that you wish you"
    } ]
  }, {
    "tStartMs": 328720,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "had known at the beginning?"
    } ]
  }, {
    "tStartMs": 329940,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "What is that lesson that\nyou think we have now"
    } ]
  }, {
    "tStartMs": 332960,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "that we didn't have when you\nwere studying at Columbia"
    } ]
  }, {
    "tStartMs": 335620,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "Business School, these ideas?"
    } ]
  }, {
    "tStartMs": 336800,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "- Yeah. Thank you, Tono."
    } ]
  }, {
    "tStartMs": 340000,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "First of all, thank you all to be here."
    } ]
  }, {
    "tStartMs": 343960,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "It is such a wonderful,\nwonderful occasion."
    } ]
  }, {
    "tStartMs": 347560,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "Like when I was a student as\nwell as a young professional,"
    } ]
  }, {
    "tStartMs": 351520,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "I have also attended a\nfew of those luncheons."
    } ]
  }, {
    "tStartMs": 355840,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "It was the highlight."
    } ]
  }, {
    "tStartMs": 357540,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "I hope I do some justice\nnow that 30 years later."
    } ]
  }, {
    "tStartMs": 362140,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "Now, of course, the discipline"
    } ]
  }, {
    "tStartMs": 363800,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "of a value investing\nstarted with a Columbia."
    } ]
  }, {
    "tStartMs": 367220,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Now almost think about when"
    } ]
  }, {
    "tStartMs": 370640,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Ben Graham first started this classes is"
    } ]
  }, {
    "tStartMs": 373400,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "almost 90 years ago."
    } ]
  }, {
    "tStartMs": 375400,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "And of course they practiced\n10, 20 years before that."
    } ]
  }, {
    "tStartMs": 379280,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "So we call it 100 years\nold really discipline"
    } ]
  }, {
    "tStartMs": 383900,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "and is really do have evolved,"
    } ]
  }, {
    "tStartMs": 387660,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "but some of the core\nprinciples really have not"
    } ]
  }, {
    "tStartMs": 391980,
    "dDurationMs": 1480,
    "segs": [ {
